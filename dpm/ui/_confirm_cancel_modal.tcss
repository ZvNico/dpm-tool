ConfirmCancelModal {
    align: center middle;
}
#dialog {
    width: 52;
    height: auto;
    border: round $error;
    background: $surface;
    padding: 1 2;
}
#msg {
    text-style: bold;
    margin-bottom: 0;
}
#sub {
    color: $text-muted;
    margin-bottom: 1;
}
#btn-row {
    height: auto;
    margin-top: 1;
}
#btn-keep   { width: 1fr; margin-right: 1; }
#btn-cancel { width: 1fr; }
