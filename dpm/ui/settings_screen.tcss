SettingsScreen {
    align: center middle;

    #card {
        width: 80;
        height: auto;
        max-height: 90%;
        padding: 1 2;
    }

    /* ── hero ──────────────────────────────────────────────────────────── */
    #hero {
        height: auto;
        padding: 1 2;
        margin-bottom: 1;
        border: round $primary;
        background: $boost;
    }
    #brand {
        width: 100%;
        text-align: center;
        text-style: bold;
        color: $primary;
    }
    #tagline {
        width: 100%;
        text-align: center;
        color: $text-muted;
    }

    /* ── add row ────────────────────────────────────────────────────────── */
    #add-row {
        height: auto;
        margin-bottom: 1;
    }
    #add-row #inp-version {
        width: 2fr;
        margin-right: 1;
    }
    #add-row #inp-url {
        width: 3fr;
        margin-right: 1;
    }
    #add-row #btn-add {
        width: auto;
    }

    /* ── list ───────────────────────────────────────────────────────────── */
    #versions-table {
        width: 100%;
        height: 1fr;
        min-height: 6;
        border: round $primary-darken-2;
    }
}
