SettingsScreen {
    align: center middle;

    #card {
        width: 80;
        height: auto;
        max-height: 90%;
        padding: 1 2;
    }

    /* ── hero ──────────────────────────────────────────────────────────── */
    #hero {
        height: auto;
        padding: 1 2;
        margin-bottom: 1;
        border: round $primary;
        background: $boost;
    }
    #brand {
        width: 100%;
        text-align: center;
        text-style: bold;
        color: $primary;
    }
    #tagline {
        width: 100%;
        text-align: center;
        color: $text-muted;
    }

    /* ── proxy row ───────────────────────────────────────────────────────── */
    #proxy-row {
        height: auto;
        margin-bottom: 1;
    }
    #proxy-row #inp-proxy {
        width: 1fr;
        margin-right: 1;
    }
    #proxy-row #btn-test-proxy {
        width: auto;
        margin-right: 1;
    }
    #proxy-row #btn-proxy {
        width: auto;
    }

    /* ── add row ────────────────────────────────────────────────────────── */
    #add-row {
        height: auto;
        margin-bottom: 1;
    }
    #add-row #inp-version {
        width: 2fr;
        margin-right: 1;
    }
    #add-row #inp-url {
        width: 3fr;
        margin-right: 1;
    }
    #add-row #btn-add {
        width: auto;
    }

    /* ── list ───────────────────────────────────────────────────────────── */
    #versions-list {
        width: 100%;
        height: 1fr;
        min-height: 6;
        border: round $primary-darken-2;
    }
    .empty {
        width: 100%;
        text-align: center;
        color: $text-muted;
        padding: 1;
    }
    VersionRow {
        layout: horizontal;
        height: auto;
        width: 100%;
        padding: 0 1;
    }
    VersionRow .ver-name {
        width: 1fr;
        content-align: left middle;
        height: 3;
    }
    VersionRow .ver-source {
        width: 2fr;
        content-align: left middle;
        height: 3;
        color: $text-muted;
    }
    VersionRow .row-dl {
        width: auto;
        margin-left: 1;
    }
    VersionRow .row-del {
        width: auto;
        min-width: 5;
        margin-left: 1;
    }

    /* ── progress ───────────────────────────────────────────────────────── */
    #progress {
        height: auto;
        margin-top: 1;
    }
    #step-label {
        width: 100%;
        color: $text-muted;
    }
    #progress-bar {
        width: 100%;
    }
}
