ExploreDeltaScreen {
    layout: vertical;

    #topbar {
        height: auto;
        padding: 1 2 0 2;
    }
    #topbar #sel-old, #topbar #sel-new {
        width: 22;
        margin-right: 1;
    }
    #topbar #btn-open {
        width: auto;
    }
    #overview {
        height: 2;
        padding: 0 2;
        color: $text-muted;
        content-align: left middle;
    }

    #tabs {
        height: 1fr;
    }
    #tabs ContentSwitcher {
        height: 1fr;
    }
    #tabs TabPane {
        height: 1fr;
        padding: 0 1;
    }

    #structure-row {
        height: 1fr;
    }
    #delta-tree {
        width: 44;
        height: 100%;
        border-right: solid $primary;
    }
    #cells-detail {
        width: 1fr;
        height: 100%;
        padding: 0 1;
    }
    #cells-detail Label {
        color: $text-muted;
        margin-top: 1;
    }
    #cells-table {
        width: 100%;
        height: 2fr;
    }
    #cell-dims {
        width: 100%;
        height: 1fr;
    }

    #metrics-col {
        height: 1fr;
    }
    #inp-metric-search, #inp-dimension-search {
        width: 100%;
        margin-bottom: 1;
    }
    #metrics-table {
        width: 100%;
        height: 1fr;
    }

    #dimensions-row {
        height: 1fr;
    }
    #dims-left {
        width: 1fr;
        height: 100%;
        border-right: solid $primary;
        padding-right: 1;
    }
    #dims-table {
        width: 100%;
        height: 1fr;
    }
    #dims-right {
        width: 1fr;
        height: 100%;
        padding-left: 1;
    }
    #dims-right Label {
        color: $text-muted;
    }
    #members-table {
        width: 100%;
        height: 1fr;
    }

    #bottombar {
        height: auto;
        padding: 0 2 1 2;
    }
    #btn-back {
        width: auto;
        margin-right: 2;
    }
}
